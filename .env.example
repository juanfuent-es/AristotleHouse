# Copy into your process manager. Nothing here is committed with real values.
APP_HOST=                 # public host, once the domain exists (no protocol)
COMING_SOON=true          # "false" opens the whole site to visitors
ADMIN_EMAIL=             # default: admin@aristotle-house.com
ADMIN_PASSWORD=          # required to seed in production
CONTACT_EMAIL=
MAIL_FROM=
INSTAGRAM_URL=
LINKEDIN_URL=
WEATHER_USER_AGENT=        # MET Norway requires it in production: app or domain plus a contact
GTM_ID=
SENTRY_DSN=
DATABASE_HOST=localhost
DATABASE_USER=postgres
DATABASE_PASSWORD=
SECRET_KEY_BASE=          # bin/rails secret
EDITORIAL_STORAGE_ROOT=   # private media; default: storage/editorial. Keep it between deploys, with public/media
