<% provide(:theme, "day") %>
<article>
  <header class="gutter pb-10 pt-12 md:pt-20">
    <h1 class="display max-w-[16ch] !text-[clamp(2.5rem,1rem+4.6vw,6rem)]"><%= @page.title %></h1>
    <p class="subhead mt-8 max-w-[44ch]"><%= @page.og_description %></p>
    <p class="mt-6 text-base text-[var(--text-muted)]"><%= l @page.created_at.to_date, format: :long %></p>
  </header>
  <% if @page.cover? %><%= image_tag @page.og_image.url, alt: "", class: "max-h-[90vh] w-full object-cover" %><% end %>
  <div class="gutter">
    <% if @page.content.present? %><div class="prose-house max-w-[65ch] py-10"><%= paragraphs @page.content %></div><% end %>
    <%= render "content/story", page: @page %>
    <% if @page.tags.any? %><p class="flex flex-wrap gap-2 py-6"><% @page.tags.each do |tag| %><span class="tag"><%= tag.name %></span><% end %></p><% end %>
  </div>
</article>
