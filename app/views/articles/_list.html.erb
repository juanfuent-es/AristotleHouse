<ul>
  <% articles.each do |article| %>
    <li class="rule pb-10">
      <%= link_to article.public_path, class: "group grid gap-x-10 gap-y-3 md:grid-cols-12" do %>
        <h3 class="headline !text-3xl group-hover:text-[var(--accent)] md:col-span-7"><%= article.title %></h3>
        <div class="md:col-span-5"><p class="text-[var(--text-soft)]"><%= article.og_description %></p><p class="mt-3 text-base text-[var(--text-muted)]"><%= l article.created_at.to_date, format: :long %></p></div>
      <% end %>
    </li>
  <% end %>
</ul>
