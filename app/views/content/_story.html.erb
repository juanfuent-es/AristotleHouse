<% media = { "image" => Image, "video" => Video }.to_h { |kind, model| [kind, model.where(id: page.blocks_of(kind).map(&:content)).index_by(&:id)] } %>
<div class="space-y-16 py-10 md:space-y-24">
  <% page.story.each do |block| %>
    <% case block.category %>
    <% when "text" %>
      <section class="grid gap-x-10 gap-y-5 md:grid-cols-12">
        <% if block.title.present? %><h2 class="headline !text-3xl md:col-span-4"><%= block.title %></h2><% end %>
        <div class="prose-house max-w-[65ch] md:col-span-7 md:col-start-6"><%= paragraphs block.content %></div>
      </section>
    <% when "quote" %>
      <figure class="max-w-5xl"><blockquote class="headline">“<%= block.content %>”</blockquote><% if block.title.present? %><figcaption class="mt-5 text-[var(--text-muted)]"><%= block.title %></figcaption><% end %></figure>
    <% when "image" %>
      <% if (image = media["image"][block.content]) %>
        <figure><%= image_tag image.file.fhd.url, alt: image.alt, loading: "lazy", class: "h-auto w-full" %><% if block.title.present? %><figcaption class="mt-3 text-base text-[var(--text-muted)]"><%= block.title %></figcaption><% end %></figure>
      <% end %>
    <% when "video" %>
      <% if (video = media["video"][block.content]) %>
        <figure><%= video_tag video.file.url, controls: true, playsinline: true, preload: "metadata", class: "w-full" %><% if block.title.present? %><figcaption class="mt-3 text-base text-[var(--text-muted)]"><%= block.title %></figcaption><% end %></figure>
      <% end %>
    <% end %>
  <% end %>
</div>
