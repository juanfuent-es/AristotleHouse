<%= render "devise/shared/header", title: "Login" %>
<section class="text-white mx-auto max-w-7xl p-4 lg:p-8">

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), class: 'grid grid-cols-1 gap-6 mt-8 space-y-6') do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <%= f.hidden_field :email, autofocus: true, required: true, placeholder: "input@juanfuent.es", value: "input@juanfuent.es", autocomplete: "email", :class => "", readonly: true %>

  <%= f.label :password, class: '' do %>
  <h1 class="font-medium">Password Login</h1>
  <%= f.password_field :password, required: true, placeholder: "********", autocomplete: "current-password", :class => "bg-black-900" %>
  <% end %>

  <footer>
    <%= f.submit "Enter", class: "" %>
  </footer>


  <% end %>
</section>