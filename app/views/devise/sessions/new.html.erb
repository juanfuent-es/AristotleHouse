<% provide(:title, "Sign in") %>
<h1 class="headline mb-8">Sign in</h1>
<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "grid gap-5" }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <div class="field">
    <%= f.label :email, "Email" %>
    <%= f.email_field :email, class: "input", required: true, autofocus: true, autocomplete: "email" %>
  </div>
  <div class="field">
    <%= f.label :password, "Password" %>
    <%= f.password_field :password, class: "input", required: true, autocomplete: "current-password" %>
  </div>
  <label class="flex items-center gap-3"><%= f.check_box :remember_me, class: "size-5 accent-violet" %> Remember me</label>
  <%= f.submit "Sign in", class: "btn" %>
<% end %>
