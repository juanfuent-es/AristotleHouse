<%- if devise_mapping.omniauthable? %>
<div class="social-auth-links text-center">
  <p>- <%= t(:or) %> -</p>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <%= link_to omniauth_authorize_path(resource_name, provider), class: "btn btn-block btn-primary", method: :post do %>
      <%= "#{t(:login_with)} #{OmniAuth::Utils.camelize(provider)}" %>
    <% end %>
  <% end %>
</div>
<% end %>

<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
<div class='block'>
  <%= link_to t("didn_t_receive_unlock_instructions"), new_unlock_path(resource_name, lang:@lang) %>
</div>
<% end %>