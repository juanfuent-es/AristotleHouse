<%# The case itself. The same markup is read by visitors and written by the editor. %>
<% form = local_assigns[:form] %>
<% preview = local_assigns[:preview] %>
<article class="case">
  <header class="gutter pb-10 pt-12 md:pt-20">
    <% if form %>
      <%= form.label :title, class: "sr-only" %>
      <%= form.text_area :title, rows: 1, maxlength: 160, required: true, placeholder: "Project title", class: "edit display", aria: field_state(content, :title), data: { action: "input->content-editor#resize" } %>
      <%= field_error(content, :title) %>
      <%= form.label :description, "Summary", class: "sr-only" %>
      <%= form.text_area :description, rows: 1, maxlength: 300, placeholder: "One sentence that says what was built and what people did in it.", class: "edit subhead mt-8 max-w-[40ch]", aria: field_state(content, :description), data: { action: "input->content-editor#resize" } %>
      <%= field_error(content, :description) %>
    <% else %>
      <h1 class="display max-w-[14ch] [overflow-wrap:anywhere]"><%= content.title %></h1>
      <% if content.description.present? %><p class="subhead mt-8 max-w-[40ch]"><%= content.description %></p><% end %>
    <% end %>
  </header>

  <% url = cover_url(content, preview: preview) %>
  <% if form %>
    <div class="edit-cover" data-content-editor-target="coverBox">
      <img src="<%= url %>" alt="" class="case__cover" data-content-editor-target="cover" <%= "hidden" unless url %>>
      <%= form.hidden_field :cover_image_id, data: { content_editor_target: "coverId" } %>
      <div class="edit-cover__tools">
        <button type="button" class="btn btn--small" data-action="content-editor#chooseCover"><span data-content-editor-target="coverLabel"><%= url ? "Change cover" : "Add a cover" %></span></button>
        <button type="button" class="btn btn--small btn--quiet" data-content-editor-target="coverRemove" data-action="content-editor#removeCover" <%= "hidden" unless url %>>Remove</button>
      </div>
      <%= field_error(content, :cover_image_id) %>
    </div>
  <% elsif url %>
    <%= image_tag url, alt: content.cover_image.alt, width: content.cover_image.width, height: content.cover_image.height, class: "case__cover", fetchpriority: "high" %>
  <% end %>

  <div class="gutter">
    <% if form || content.facts.values.any?(&:present?) %>
      <dl class="case__facts">
        <% Page::FACTS.each do |name| %>
          <% next unless form || content.fact(name) %>
          <div>
            <dt><%= form ? label_tag("page_facts_#{name}", name.capitalize) : name.capitalize %></dt>
            <dd class="title"><% if form %><%= text_field_tag "page[facts][#{name}]", content.facts[name], id: "page_facts_#{name}", maxlength: 80, placeholder: "Not set", autocomplete: "off", class: "edit title" %><% else %><%= content.fact(name) %><% end %></dd>
          </div>
        <% end %>
      </dl>
      <%= field_error(content, :facts) %>
    <% end %>

    <div class="py-10 md:py-16">
      <% if form %><%= render "editor/shared/rich_text", form: form, content: content, label: "Story" %><% else %><%= rich_text(content, preview: preview) %><% end %>
    </div>

    <% if form %>
      <div class="field max-w-[40ch] py-6"><%= form.label :tag_list, "Tags" %><%= form.text_field :tag_list, class: "input", autocomplete: "off", aria: field_state(content, :tag_list) %><p class="field__hint">Separate them with commas. 20 characters each.</p><%= field_error(content, :tag_list) %></div>
    <% else %>
      <p class="micro flex items-end gap-4 pt-6 text-(--text-muted)"><%= micrograph :peripatetic, class: "h-10 w-7 text-(--text)" %><span class="bracket">Perceive → Understand → Build</span></p>
      <% if content.tag_names.any? %><p class="flex flex-wrap gap-2 py-6"><% content.tag_names.each do |name| %><span class="tag"><%= name %></span><% end %></p><% end %>
    <% end %>
  </div>
</article>
