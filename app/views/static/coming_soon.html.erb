<% provide(:title, "Coming soon") %>
<main class="holding" data-holding>
  <picture class="holding__poster">
    <source media="(max-aspect-ratio: 4/5)" srcset="/brand/poster-portrait.webp" type="image/webp">
    <img src="/brand/poster.webp" alt="" width="1920" height="1080" fetchpriority="high">
  </picture>
  <canvas class="holding__canvas" aria-hidden="true" data-model="/models/aristotle_2k_webp.glb" data-model-small="/models/aristotle_1k_webp.glb"></canvas>

  <header class="gutter micro flex items-start justify-between gap-6 pt-6">
    <%= lockup(class: "w-52 h-auto md:w-72") %>
    <p class="text-right"><%= site.tagline %><br><span class="text-soft">Est. <%= site.established %></span></p>
  </header>

  <div class="holding__word">
    <h1><span data-glass>Coming</span> <span data-glass>soon</span></h1>
  </div>

  <footer class="gutter micro grid grid-cols-2 items-end gap-x-6 gap-y-3 pb-5 md:grid-cols-3">
    <p><%= site.city %>, <%= site.country %><br><span class="text-soft"><%= site.coordinates.first %>&ensp;<%= site.coordinates.last %></span></p>
    <div class="holding__live holding__spectra order-last col-span-2 flex justify-center gap-2 md:order-none md:col-span-1" role="group" aria-label="Reading">
      <button type="button" class="micro" data-spectrum="lyceum" aria-pressed="true">Lyceum</button>
      <button type="button" class="micro" data-spectrum="ring" aria-pressed="false">Isotherm</button>
      <button type="button" class="micro" data-spectrum="ultra" aria-pressed="false">Ultra</button>
    </div>
    <p class="holding__live text-right" aria-hidden="true"><span class="holding__state" data-state><span class="dot"></span>Perceived</span><br><span class="text-soft" data-temperature>36.4°C</span></p>
  </footer>
</main>
