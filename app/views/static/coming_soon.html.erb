<% provide(:title, "Coming soon") %>
<main class="holding" data-holding>
  <picture class="holding__poster">
    <source media="(max-aspect-ratio: 4/5)" srcset="/brand/poster-portrait.webp" type="image/webp">
    <img src="/brand/poster.webp" alt="" width="1920" height="1080" fetchpriority="high">
  </picture>
  <canvas class="holding__canvas" aria-hidden="true" data-model="/models/aristotle_2k_webp.glb" data-model-small="/models/aristotle_1k_webp.glb"></canvas>

  <header class="gutter micro flex items-center justify-between gap-6 pt-6">
    <div>
      <%= lockup(class: "only-night w-44 h-auto md:w-52") %>
      <%= lockup(tone: :dark, class: "only-day w-44 h-auto md:w-52") %>
    </div>
    <p class="text-right"><%= site.tagline %></p>
  </header>

  <div class="holding__side holding__live gutter" role="group" aria-label="View of the bust">
    <% [["left", "head-left", "Left profile"], ["front", "head-front", "Front"], ["right", "head-right", "Right profile"]].each do |view, symbol, label| %>
      <button type="button" class="holding__view" data-view="<%= view %>" aria-pressed="<%= view == "front" %>" aria-label="<%= label %>"><%= micrograph symbol, class: "size-6" %></button>
    <% end %>
  </div>

  <div class="holding__word">
    <h1><span data-glass>Coming</span> <span data-glass>soon</span></h1>
  </div>

  <footer class="gutter micro flex flex-wrap items-center justify-between gap-x-6 pb-3">
    <p class="holding__air"><%= site.city %> <span data-ui="clock"></span><span class="holding__weather">&emsp;<span data-ui="temperature"></span>&emsp;Wind <span class="normal-case" data-ui="wind"></span></span></p>
    <div class="holding__hours holding__live flex gap-1" role="group" aria-label="Time of day">
      <button type="button" class="micro" data-hour="" aria-pressed="true">Live</button>
      <button type="button" class="micro" data-hour="13:00" aria-pressed="false">Day</button>
      <button type="button" class="micro" data-hour="23:00" aria-pressed="false">Night</button>
    </div>
  </footer>

  <div class="holding__sight" data-ui="sight" aria-hidden="true"><%= micrograph :crosshair, class: "size-5" %></div>
</main>
