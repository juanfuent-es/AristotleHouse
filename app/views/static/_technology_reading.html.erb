<% day = @reading[:drive][:day] == 1.0 %>
<aside id="reading" data-reading class="technology-reading <%= day ? "day" : "night" %> mt-12 scroll-mt-8 p-6 md:p-10" aria-labelledby="reading-title">
  <div class="flex flex-wrap items-start justify-between gap-6">
    <div>
      <h3 id="reading-title" class="title"><%= @preview_hour ? "Preview reading" : "Current reading" %></h3>
      <p class="mt-2 text-base text-(--text-soft)" aria-live="polite"><%= site.city %> · <%= @reading[:clock] %> GST · Sun <%= @reading[:sun] %>° · <%= day ? "Day" : "Night" %> ground</p>
    </div>
    <nav class="flex flex-wrap gap-2" aria-label="Preview the system at a different hour">
      <% [["Now", nil], ["Day · 13:00", "13:00"], ["Night · 23:00", "23:00"]].each do |label, hour| %>
        <%= link_to label, technology_path(at: hour, anchor: "reading"), class: "btn btn--small#{" btn--quiet" unless @preview_hour == hour}", data: { hour: hour.to_s }, aria: { current: @preview_hour == hour ? "true" : nil } %>
      <% end %>
    </nav>
  </div>

  <% if (weather = @reading[:weather]) %>
    <dl class="mt-8 grid grid-cols-2 gap-6 md:grid-cols-4">
      <% [["Temperature", "#{weather[:temperature]}°C", :warmth, "Warmth"], ["Wind", "#{weather[:wind]} m/s", :wind, "Drift"], ["Humidity", "#{weather[:humidity]}%", :haze, "Halo"], ["Cloud cover", "#{weather[:cloud]}%", :cloud, "Softened light"]].each do |label, value, parameter, effect| %>
        <div class="rule">
          <dt class="text-base text-(--text-soft)"><%= label %></dt>
          <dd class="subhead mt-2"><%= value %></dd>
          <dd class="mt-4 text-sm text-(--text-soft)">
            <%= effect %> · <%= @reading[:drive][parameter] %>
            <meter class="technology-meter" min="0" max="1" value="<%= @reading[:drive][parameter] %>" aria-label="<%= effect %> parameter"><%= @reading[:drive][parameter] %></meter>
          </dd>
        </div>
      <% end %>
    </dl>
    <p class="mt-8 max-w-[75ch] text-sm text-(--text-muted)">Weather inputs are interpolated from a forecast, rather than measured on site. Source: <%= link_to @reading[:source][:name], @reading[:source][:url], class: "link" %>. Choose an hour to recalculate this snapshot using the same climate object as the 3D scene.</p>
  <% else %>
    <p class="rule mt-8 max-w-[75ch] text-base text-(--text-soft)">The forecast is unavailable for this reading. The sun still determines the day or night ground; the scene uses baseline settings for the other effects.</p>
  <% end %>
</aside>
