<header class="gutter pb-16 pt-16 md:pt-24"><h1 class="display max-w-[14ch]"><%= @page&.description.presence || "Tell us what you want people to feel." %></h1></header>
<div class="gutter grid gap-10 md:grid-cols-2">
  <div class="rule">
    <% if site.contact_email %><p class="subhead"><%= mail_to site.contact_email, site.contact_email, class: "link" %></p><% else %><p class="subhead text-soft">Our contact details will be here soon.</p><% end %>
    <% if @page && Content::Html.meaningful?(@page.content) %><div class="mt-8"><%= rich_text(@page, preview: @preview) %></div><% end %>
  </div>
  <div class="rule"><p class="subhead"><%= site.city %>, <%= site.country %></p><p class="micro mt-4 flex items-center gap-4 text-soft"><%= micrograph :globe, class: "h-5 w-8" %><%= site.coordinates.join("  ") %></p></div>
</div>
