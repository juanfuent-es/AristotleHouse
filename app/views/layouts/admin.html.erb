<!DOCTYPE html>
<html lang="en" class="day">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title><%= full_title(yield(:title)) %></title>
    <%= render "shared/fonts" %>
    <%= render "shared/favicons" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
  </head>
  <body class="min-h-dvh lg:grid lg:grid-cols-[16rem_minmax(0,1fr)]">
    <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
    <aside class="border-b border-[var(--rule)] px-4 py-4 lg:sticky lg:top-0 lg:h-dvh lg:overflow-y-auto lg:border-b-0 lg:border-r lg:px-5 lg:py-6">
      <%= link_to admin_path, class: "block pb-4 lg:pb-8" do %><%= lockup(tone: :dark, class: "w-48 h-auto") %><% end %>
      <nav class="flex flex-wrap gap-1 lg:block lg:space-y-1" aria-label="Admin">
        <%= link_to "Overview", admin_path, class: "admin-link", "aria-current": (request.path == admin_path ? "page" : nil) %>
        <% [["Projects", admin_projects_path], ["Articles", admin_articles_path], ["Pages", admin_pages_path], ["Images", admin_images_path], ["Videos", admin_videos_path], ["Clients", admin_clients_path], ["Share files", admin_ogs_path]].each do |label, path| %>
          <%= nav_item label, path, class: "admin-link" %>
        <% end %>
      </nav>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 border-t border-[var(--rule)] pt-4 text-base lg:mt-8 lg:block lg:space-y-2">
        <p><%= link_to "View site", home_path, class: "link" %></p>
        <p><%= link_to "Holding screen", root_path, class: "link" %></p>
        <p><%= link_to "Sign out", destroy_user_session_path, class: "link" %></p>
      </div>
    </aside>
    <main id="main" class="min-w-0 px-4 py-6 lg:px-10 lg:py-8">
      <% if notice.present? %><p class="notice mb-6" role="status"><%= notice %></p><% end %>
      <% if alert.present? %><p class="notice notice--error mb-6" role="alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
    <%= vite_client_tag %>
    <%= vite_javascript_tag "admin" %>
  </body>
</html>
