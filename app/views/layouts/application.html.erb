<!DOCTYPE html>
<html lang="<%= @lang %>" class="<%= content_for(:theme).presence || "night" %>">
  <head><%= render "shared/head" %></head>
  <body class="flex min-h-dvh flex-col">
    <a href="#app" class="sr-only focus:not-sr-only">Skip to content</a>
    <%= render "shared/admin_bar" %>
    <%= render "shared/header" %>
    <main id="app" class="flex-1"><%= yield %></main>
    <%= render "shared/footer" %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag "application" %>
  </body>
</html>
