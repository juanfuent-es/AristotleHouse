<%# The only page shell. admin, devise, errors and coming_soon render inside it. %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="night">
  <head><%= render "shared/head" %></head>
  <body class="isolate flex min-h-dvh flex-col">
    <a href="#app" class="sr-only focus:not-sr-only">Skip to content</a>
    <% unless @bare %><%= render "shared/toolbar" %><% end %>
    <%= render "shared/header" %>
    <main id="app" class="flex flex-1 flex-col">
      <%= render "shared/flash" unless @editing %>
      <%= content_for?(:shell) ? yield(:shell) : yield %>
    </main>
    <% unless @stage %><%= render "shared/footer" %><% end %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag @stage ? "coming_soon" : "application" %>
    <%= vite_javascript_tag "editor" if @editing %>
  </body>
</html>
