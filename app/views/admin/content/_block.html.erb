<%# category nil renders every field: the template keeps only the ones it needs %>
<% show = ->(*kinds) { category.nil? || kinds.include?(category) } %>
<% heading = { "text" => "Heading", "quote" => "Who said it", "fact" => "Label", "metric" => "Label", "image" => "Caption", "video" => "Caption" } %>
<fieldset class="panel" data-block>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <legend class="float-left font-medium capitalize" data-name><%= category %></legend>
    <div class="flex gap-2">
      <button type="button" class="btn btn--quiet btn--small" data-action="up">Move up</button>
      <button type="button" class="btn btn--quiet btn--small" data-action="down">Move down</button>
      <button type="button" class="btn btn--danger btn--small" data-action="remove">Remove</button>
    </div>
  </div>
  <%= f.hidden_field :category, data: { category: true } %>
  <%= f.hidden_field :number, data: { number: true } %>
  <% if f.object.persisted? %><%= f.hidden_field :_destroy, data: { destroy: true } %><% end %>
  <div class="grid gap-4">
    <% heading.each do |kind, text| %>
      <% next unless show.(kind) %>
      <div class="field" data-for="<%= kind %>"><%= f.label :title, text, for: "#{f.field_id(:title)}_#{kind}" %><%= f.text_field :title, id: "#{f.field_id(:title)}_#{kind}", class: "input", maxlength: 70, list: (kind == "fact" ? "fact-labels" : nil) %></div>
    <% end %>
    <% if show.("text", "quote") %>
      <div class="field" data-for="text quote"><%= f.label :content, "Text", for: f.field_id(:content, :long) %><%= f.text_area :content, id: f.field_id(:content, :long), class: "input", rows: 5 %></div>
    <% end %>
    <% if show.("fact", "metric") %>
      <div class="field" data-for="fact metric"><%= f.label :content, "Value", for: f.field_id(:content, :value) %><%= f.text_field :content, id: f.field_id(:content, :value), class: "input" %></div>
    <% end %>
    <% { "image" => @images, "video" => @videos }.each do |kind, library| %>
      <% next unless show.(kind) %>
      <div class="field" data-for="<%= kind %>">
        <%= f.label :content, kind.capitalize, for: f.field_id(:content, kind) %>
        <%= f.select :content, library.map { |m| [m.title, m.id] }, { prompt: "Choose from the library" }, id: f.field_id(:content, kind), class: "input" %>
        <% if library.empty? %><p class="field__hint">The library is empty. <%= link_to "Add one", kind == "image" ? new_admin_image_path : new_admin_video_path, class: "link", target: "_blank", rel: "noopener" %>, then reload this page.</p><% end %>
      </div>
    <% end %>
  </div>
</fieldset>
