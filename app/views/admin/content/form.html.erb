<% label = kind == "static" ? "page" : kind %>
<% provide(:title, @page.persisted? ? @page.title_was : "New #{label}") %>
<%= form_with model: @page, scope: :page, url: member_path(@page), method: (@page.persisted? ? :patch : :post), multipart: true, data: { guard: (@page.errors.any? ? "dirty" : "clean") } do |f| %>
  <header class="mb-8 flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="text-base"><%= link_to "Back to #{label}s", collection_path, class: "link" %></p>
      <h1 class="headline mt-2 !text-4xl"><%= @page.persisted? ? @page.title_was : "New #{label}" %></h1>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <% if @page.persisted? %>
        <span class="tag <%= "tag--on" if @page.category_was == kind %>"><%= @page.category_was == kind ? "Published" : "Draft" %></span>
        <%= link_to @page.category_was == kind ? "View" : "Preview", @page.public_path, class: "btn btn--quiet" %>
      <% end %>
      <% if kind == "static" %>
        <%= f.button "Save", class: "btn", type: :submit %>
      <% else %>
        <%= f.button @page.category_was == kind ? "Unpublish" : "Save draft", name: "page[status]", value: "draft", class: "btn btn--quiet", type: :submit %>
        <%= f.button @page.category_was == kind ? "Save and keep published" : "Publish", name: "page[status]", value: "published", class: "btn", type: :submit %>
      <% end %>
    </div>
  </header>

  <%= render "admin/shared/errors", object: @page %>

  <div class="grid gap-8 xl:grid-cols-[minmax(0,1fr)_22rem]">
    <div class="space-y-8">
      <section class="panel space-y-5">
        <div class="field"><%= f.label :title %><%= f.text_field :title, class: "input", required: true, maxlength: 70, data: { count: "title-count" } %><p class="field__hint" id="title-count"></p></div>
        <div class="field"><%= f.label :og_description, "Summary" %><%= f.text_area :og_description, class: "input !min-h-24", maxlength: 200, rows: 3, data: { count: "summary-count" } %><p class="field__hint">Shown on cards, in search results and when the link is shared. <span id="summary-count"></span></p></div>
        <div class="field"><%= f.label :content, kind == "static" ? "Text" : "Introduction" %><%= f.text_area :content, class: "input", rows: 6 %><p class="field__hint">Leave a blank line between paragraphs.</p></div>
      </section>

      <section data-blocks aria-labelledby="blocks-title">
        <h2 class="title mb-1" id="blocks-title">Content blocks</h2>
        <p class="mb-4 text-base text-[var(--text-muted)]">Facts and metrics are shown in their own areas. Text, quotes, images and video follow the order below.</p>
        <p class="sr-only" role="status" data-blocks-status></p>
        <div class="space-y-4" data-blocks-list>
          <%= f.fields_for :blocks do |b| %><%= render "admin/content/block", f: b, category: b.object.category %><% end %>
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          <% Block::EDITORIAL.each do |category| %><button type="button" class="btn btn--quiet btn--small" data-action="add" data-category="<%= category %>">Add <%= category %></button><% end %>
        </div>
        <datalist id="fact-labels"><option value="Client"><option value="Location"><option value="Year"><option value="Scope"><option value="Event"></datalist>
        <template><%= f.fields_for :blocks, Block.new(category: "text"), child_index: "NEW_BLOCK" do |b| %><%= render "admin/content/block", f: b, category: nil %><% end %></template>
      </section>
    </div>

    <aside class="space-y-6">
      <section class="panel space-y-4">
        <h2 class="title">Cover</h2>
        <%= image_tag @page.cover? ? @page.og_image.card.url : "", id: "cover-preview", alt: "Current cover", hidden: !@page.cover?, class: "aspect-video w-full object-cover" %>
        <div class="field"><%= f.label :og_image, @page.cover? ? "Replace cover" : "Choose a cover" %><%= f.file_field :og_image, class: "input", accept: "image/jpeg,image/png,image/webp", data: { preview: "cover-preview" } %><%= f.hidden_field :og_image_cache %></div>
        <% if @page.cover? %><label class="flex items-center gap-3 text-base"><%= f.check_box :remove_og_image, class: "size-5 accent-violet" %> Remove the cover</label><% end %>
      </section>
      <section class="panel space-y-4">
        <h2 class="title">Details</h2>
        <div class="field"><%= f.label :slug, "URL" %><%= f.text_field :slug, class: "input", disabled: @page.restricted %><p class="field__hint"><%= @page.restricted ? "This page is part of the site. Its URL is fixed." : "Leave it empty to build it from the title." %></p></div>
        <% unless kind == "static" %><div class="field"><%= f.label :tag_list, "Tags" %><%= f.text_field :tag_list, class: "input" %><p class="field__hint">Separate them with commas. 20 characters each.</p></div><% end %>
        <div class="field"><%= f.label :og_title, "Share title" %><%= f.text_field :og_title, class: "input", maxlength: 70 %><p class="field__hint">Leave it empty to use the title.</p></div>
        <div class="field"><%= f.label :keywords %><%= f.text_field :keywords, class: "input" %></div>
      </section>
      <% if @page.persisted? && !@page.restricted %>
        <%= link_to "Delete #{label}", url_for(action: :destroy, id: @page.id), method: :delete, data: { confirm: "Delete “#{@page.title_was}”? This cannot be undone." }, class: "btn btn--danger w-full" %>
      <% end %>
    </aside>
  </div>
<% end %>
