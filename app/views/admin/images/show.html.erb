<%= render "admin/shared/heading", title: @image.title %>
<%= render "admin/shared/errors", object: @image %>
<div class="grid gap-8 xl:grid-cols-[minmax(0,1fr)_22rem]">
  <%= image_tag @image.file.hd.url, alt: @image.alt, class: "w-full h-auto" %>
  <div class="space-y-4">
    <%= form_with model: [:admin, @image], class: "panel grid gap-4" do |f| %>
      <div class="field"><%= f.label :alt, "Alternative text" %><%= f.text_field :alt, class: "input", maxlength: 255 %></div>
      <p><%= f.submit "Save", class: "btn" %></p>
    <% end %>
    <%= link_to "Delete image", admin_image_path(@image), method: :delete, data: { confirm: "Delete “#{@image.title}”? This cannot be undone." }, class: "btn btn--danger w-full" %>
  </div>
</div>
