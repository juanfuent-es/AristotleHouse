<section class="content">
  <%= form_for [:admin, image], local: true, html: { :class=> "row" } do |f| %>
    <div class="col-md-12">
      <!-- .card/ -->
      <div class="card card-primary card-outline">
        <!-- .card-body/ -->
        <div class="card-body row">
          <%= render "admin/shared/errors", object: image %>
                    
          <div class="form-group col-md-6">            
            <%= f.label :title, t(:title) %>
            <%= f.text_field :title, class: "form-control", placeholder: t(:title), required: true %>
          </div>

          <div class="form-group col-md-6">
            <%= f.label :alt, t(:alt) %>
            <%= f.text_field :alt, class: "form-control", placeholder: t(:alt), required: true %>
          </div>
    
          <div class="form-group col-md-12">
            <%= f.label :file do %>
              <%= image_tag image.file.present? ? image.file.url : '', id: "img-preview-file" %>
              <br>Imagen
            <% end %>
            <%= f.file_field :file, required: true, class: "form-control input-img", data: { target: "#img-preview-file" } %>
          </div>
          
        </div>
        <!-- /.card-body -->
        <!-- .card-footer/ -->
        <footer class="card-footer text-right">
          <button class="btn btn-outline-primary mt-2 mb-2 btn-sm"><i class="fas fa-save"></i> <%= t(:save) %></button>
        </footer>
        <!-- /.card-footer -->
      </div>
      <!-- /.card -->
    </div>
  <% end %>
</section>