<div class="form-group col-md-9">
  <%= f.label :content %>
  <%= f.text_area :content, class: "form-control editor", placeholder: "Contenido" %>
</div>
<div class="form-group col-md-3">
  <%= f.label :category %>
  <%= f.select :category, ["text","css","js","html","glsl"], { prompt: "Seleccione" }, class: "form-control", required: true %>
</div>