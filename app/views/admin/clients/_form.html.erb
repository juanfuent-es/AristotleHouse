<%= render "admin/shared/errors", object: client %>
<%= form_with model: [:admin, client], class: "panel grid max-w-2xl gap-5" do |f| %>
  <div class="field"><%= f.label :name %><%= f.text_field :name, class: "input", required: true %></div>
  <div class="field"><%= f.label :country_id, "Country" %><%= f.collection_select :country_id, Country.where(active: true).order(:name_en), :id, :name_en, { prompt: "Choose a country" }, class: "input", required: true %></div>
  <div class="field"><%= f.label :description %><%= f.text_field :description, class: "input" %></div>
  <div class="field"><%= f.label :url, "Website" %><%= f.url_field :url, class: "input" %></div>
  <div class="field"><%= f.label :email %><%= f.email_field :email, class: "input" %></div>
  <div class="field"><%= f.label :address %><%= f.text_area :address, class: "input", rows: 3 %></div>
  <p><%= f.submit "Save", class: "btn" %></p>
<% end %>
