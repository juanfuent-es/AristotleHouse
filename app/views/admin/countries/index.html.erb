<% provide(:title, "Lista de #{t(:countries)}") %>

<!-- Content Header (Page header) -->
<header class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-12">
        <h1>Lista de <%= t(:countries) %> <sup><%= Country.all.count %></sup></h1>
      </div>
    </div>
  </div><!-- /.container-fluid -->
</header>

<!-- Main content -->
<section class="content">
  <!-- Default box -->
  <div class="card card-primary card-outline">
    <header class="card-header">
      <%= link_to new_admin_country_path, class: 'btn btn-outline-primary btn-sm float-right' do %>
        <i class="fas fa-plus"></i> <%= "#{t(:new)} #{t(:country)}" %>
      <% end %>
    </header>
    <div class="card-body">
      <table class="table table-hover table-sm datatable text-sm table-striped">
        <thead>
          <tr>
            <th>Código</th>
            <th>País</th>
            <th>Continente</th>
            <th>Códigos Alfa</th>
            <th class='text-center'>Eliminar</th>
          </tr>
        </thead>
        <tbody>
          <% @countries.each do |country| %>
            <td><%= country.code %></td>
            <td><%= link_to country.name_en, edit_admin_country_url(country), class: "btn btn-link btn-sm" %></td>
            <td><%= country.continent %><%= "/#{country.sub_continent.titleize}" if country.sub_continent.present? %></td>
            <td><%= "#{country.alpha_2}/#{country.alpha_3}".upcase %></td>
            <td class='text-center'>
              <%= link_to admin_country_path(country), method: :delete, class: "btn btn-outline-danger btn-sm" , data: { confirm: "¿Estás seguro de eliminar este #{t(:country)}?" } do %>
                <i class='fas fa-trash'></i> Eliminar
              <% end %>
            </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <!-- /.card-body -->
  </div>
  <!-- /.card -->

</section>
<!-- /.content -->