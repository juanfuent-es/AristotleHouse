<% provide(:title, "Editando #{@country.name_es}") %>

<header class="content-header">
  <div class="container-fluid">
    <div class="row mb-2">
      <div class="col-sm-6">
        <h1><%= "#{t(:editing)} #{t(:country)}" %></h1>
      </div>
      <div class="col-sm-6">
        <ol class="breadcrumb float-sm-right mt-2">
          <li class="breadcrumb-item">
            <%= link_to t(:countries), admin_countries_path %>
          </li>
          <li class="breadcrumb-item active">
            <%= "#{t(:editing)} #{t(:country)}" %>
          </li>
        </ol>
      </div>
    </div>
  </div><!-- /.container-fluid -->
</header>

<%= render 'form', country: @country %>