<section class="content">
  <%= form_for [:admin, country], local: true, html: { :class=> "row" } do |f| %>
    <div class="col-md-12">
      <!-- .card/ -->
      <%= render "admin/shared/errors", object: country %>
      <div class="card card-primary card-outline">
        <!-- .card-body/ -->
        <div class="card-body row">
          <div class="form-group col-md-6">
            <%= f.label :name_es, t(:name_es) %>
            <%= f.text_field :name_es, class: "form-control", placeholder: t(:name_es), autofocus: true, required: true %>
          </div>
          <div class="form-group col-md-6">
            <%= f.label :name_en, t(:name_en) %>
            <%= f.text_field :name_en, class: "form-control", placeholder: t(:name_en), required: true %>
          </div>    
          <div class="form-group col-md-6">
            <%= f.label :continent, t(:continent) %>
            <%= f.select :continent, ["Europa","Africa","Asia","Antarctica","Oceania","America"].sort, { include_blank: t(:continent) }, class: "form-control", placeholder: t(:continent), required: true %>
          </div>
          <div class="form-group col-md-6">
            <%= f.label :sub_continent, t(:sub_continent) %>
            <%= f.select :sub_continent, ["Europa","Africa","Asia","Antarctica","Oceania","South America", "North America"].sort, { include_blank: t(:sub_continent) }, class: "form-control", placeholder: t(:sub_continent) %>
          </div>
          <div class="form-group col-md-4">
            <%= f.label :code, t(:code) %>
            <%= f.text_field :code, class: "form-control", placeholder: t(:code), maxlength: 10, required: true %>
          </div>
          <div class="form-group col-md-4">
            <%= f.label :alpha_2, t(:alpha_2) %>
            <%= f.text_field :alpha_2, class: "form-control text-uppercase", placeholder: "XX", maxlength: 2, required: true %>
          </div>
          <div class="form-group col-md-4">
            <%= f.label :alpha_3, t(:alpha_3) %>
            <%= f.text_field :alpha_3, class: "form-control text-uppercase", placeholder: "XXX", maxlength: 3, required: true %>
          </div>
          <div class="form-group col-md-12">
            <%= f.check_box :active %>
            <%= f.label :active, "¿Activo?" %>
          </div>
        </div>
        <!-- /.card-body -->
        <!-- .card-footer/ -->
        <footer class="card-footer text-right">
          <button class="btn btn-outline-primary mt-2 mb-2 btn-sm"><i class="fas fa-save"></i> <%= t(:save) %></button>
        </footer>
        <!-- /.card-footer -->
      </div>
      <!-- /.card -->
    </div>
  <% end %>
</section>