<section class="content">
  <%= form_for [:admin, og], local: true, html: { :class=> "row" } do |f| %>
    <div class="col-md-12">
      <!-- .card/ -->
      <div class="card card-primary card-outline">
        <!-- .card-body/ -->
        <div class="card-body row">
          <%= render "admin/shared/errors", object: og %>
          
          <div class="form-group col-md-12">
            <%= f.label :category, t(:category) %>
            <%= f.select :category, [["Imagen", "image"], ["Video", "video"], ["Audio", "audio"]], { prompt: "Seleccione" }, class: "form-control", required: true %>
          </div>

          <div class="form-group col-md-12">
            <%= f.label :image, t(:img) %>
            <%= f.file_field :image, class: "form-control" %>
          </div>
                    
          <div class="form-group col-md-12">
            <%= f.label :video, t(:video) %>
            <%= f.file_field :video, class: "form-control" %>
          </div>
          
          <div class="form-group col-md-12">
            <%= f.label :audio, t(:audio) %>
            <%= f.file_field :audio, class: "form-control" %>
          </div>
          
        </div>
        <!-- /.card-body -->
        <!-- .card-footer/ -->
        <footer class="card-footer text-right">
          <button class="btn btn-outline-primary mt-2 mb-2 btn-sm"><i class="fas fa-save"></i> <%= t(:save) %></button>
        </footer>
        <!-- /.card-footer -->
      </div>
      <!-- /.card -->
    </div>
  <% end %>
</section>