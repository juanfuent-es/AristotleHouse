%>

<section id="portfolio" class="mx-auto container max-w-5xl flex items-center portrait:aspect-square landscape:aspect-video min-h-dvh">
    <header class="text-center mx-auto dark:prose-invert prose prose-2xl max-w-xl">
        <h1 class="mb-0">Portfolio</h1>
        <p class="mt-0 mb-0 pb-2">
            <strong class="font-semibold">Diseño y desarrollo digital de inicio a fin.</strong> <br>
        </p>
        <p class="mt-0 p-0 italic mx-auto">
            Exploro distintos lenguajes y elijo las herramientas que mejor responden a cada proyecto.
        </p>
        <a href="#portfolio-projects" class="no-underline uppercase !text-sm border-2 border-white px-4 py-2">
            <small>Proyectos Destacados</small>
        </a>
    </header>
</section>
<section class="mx-auto container max-w-5xl" id="portfolio-projects">
    <header class="mx-auto dark:prose-invert prose prose-xl max-w-2xl py-24 text-center">
        <%# <h2><small>Proyectos Destacados</small></h2> %>
        <p class="mt-0 p-0 italic">
            Esta selección resume problemas, soluciones, responsabilidad, colaboración y resultados de algunos de mis proyecto más relevantes.
        </p>
    </header>
    <% portfolio_projects.each do |project| %>
        <article aria-labelledby="<%= project[:id] %>" class="my-8 mx-auto dark:prose-invert prose prose-2xl max-w-xl">
            <header>
                <% if project[:img].present? %>
                    <img src="<%= project[:img] %>" alt="<%= project[:title] %>">
                <% end %>
                <h3 id="<%= project[:id] %>" class="mb-0 uppercase font-regular text-center w-full"><%= project[:title].to_s.try(:html_safe) %></h3>
                <p class="mt-0 pt-0 text-center"><em><%= project[:summary] %></em></p>
                <% if project[:meta].present? %>
                    <dl>
                        <% project[:meta].each do |label, value| %>
                            <div>
                                <dt><%= label %></dt>
                                <dd><%= value %></dd>
                            </div>
                        <% end %>
                    </dl>
                <% end %>
            </header>

            <% project[:blocks].each do |title, paragraphs| %>
                <details name="<%= project[:id] %>-accordion">
                    <summary>
                        <h4 class="cursor-pointer"><%= title.to_s.try(:html_safe) %></h4>
                    </summary>

                    <% paragraphs.each do |paragraph| %>
                        <p><%= paragraph %></p>
                    <% end %>
                </details>
            <% end %>
        </article>
        <hr>
    <% end %>
</section>
