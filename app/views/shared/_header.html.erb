<% tone = content_for(:theme).to_s == "day" ? :dark : :light %>
<header class="gutter flex items-center justify-between gap-x-6 gap-y-1 flex-wrap pt-5 pb-4">
  <%= link_to root_path, class: "block py-2" do %><%= lockup(tone: tone, class: "w-52 h-auto md:w-60") %><% end %>
  <nav class="micro flex gap-5 md:gap-8" aria-label="Main">
    <%= nav_item t("site.nav.work"), projects_path, class: "nav-link" %>
    <%= nav_item t("site.nav.thinking"), articles_path, class: "nav-link" %>
    <%= nav_item t("site.nav.house"), house_path, class: "nav-link" %>
    <%= nav_item t("site.nav.contact"), contact_path, class: "nav-link" %>
  </nav>
</header>
