<% if admin? %>
  <div class="day micro gutter flex flex-wrap items-center gap-x-6 bg-bone text-ink">
    <span><%= site.coming_soon ? "Preview · visitors see the holding screen" : "Signed in" %></span>
    <% if @page %>
      <% edit = { "project" => edit_admin_project_path(@page), "article" => edit_admin_article_path(@page), "static" => edit_admin_page_path(@page) }[@page.kind] %>
      <% unless @page.published? %><span>Draft</span><% end %>
      <%= link_to "Edit this page", edit, class: "nav-link link" if edit %>
    <% end %>
    <%= link_to "Admin", admin_path, class: "nav-link link ml-auto" %>
  </div>
<% end %>
