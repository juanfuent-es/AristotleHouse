<% if admin? %>
  <div class="admin-bar day micro gutter flex flex-wrap items-center gap-x-6 bg-bone text-ink">
    <span><%= @preview ? "Draft preview" : site.coming_soon ? "Visitors see the holding screen" : "Signed in" %></span>
    <% current = @draft || @page %>
    <% if current&.id && !@editing && Page.editorial.exists?(current.id) %><%= link_to @preview ? "Back to editing" : "Edit this page", content_edit_path(current), class: "nav-link link" %><% end %>
    <%= link_to "Projects", projects_path, class: "nav-link link ml-auto" %>
    <%= link_to "Admin", admin_path, class: "nav-link link" %>
  </div>
<% end %>
