<script type="application/ld+json"><%= raw json_escape({
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: full_title(content_for(:title).to_s),
  description: meta_description(content_for(:description).to_s),
  publisher: {
    "@type": "Organization",
    name: site.name,
    description: site.description,
    url: request.base_url,
    logo: "#{request.base_url}/android-chrome-512x512.png",
    address: { "@type": "PostalAddress", addressLocality: site.city, addressCountry: "AE" }
  }
}.to_json) %></script>
