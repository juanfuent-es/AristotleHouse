<%
  if (current = @content || @page)
    provide(:title, current.title) unless content_for?(:title)
    provide(:description, current.description) unless content_for?(:description)
    provide(:image, cover_url(current)) if cover_url(current) && !content_for?(:image)
  end
  default_image = !content_for?(:image)
  share_image = meta_image(yield(:image))
  image_alt = default_image ? "#{site.name} · #{site.tagline}" : full_title(yield(:title))
%>
<title><%= full_title(yield(:title)) %></title>
<% if @private %><meta name="robots" content="noindex, nofollow"><% end %>
<meta name="description" content="<%= meta_description(yield(:description)) %>">
<link rel="canonical" href="<%= canonical %>">

<meta property="og:site_name" content="<%= site.name %>">
<meta property="og:locale" content="en">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= full_title(yield(:title)) %>">
<meta property="og:description" content="<%= meta_description(yield(:description)) %>">
<meta property="og:image" content="<%= share_image %>">
<% if default_image %>
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="640">
<% end %>
<meta property="og:image:alt" content="<%= image_alt %>">
<meta property="og:url" content="<%= canonical %>">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= full_title(yield(:title)) %>">
<meta name="twitter:description" content="<%= meta_description(yield(:description)) %>">
<meta name="twitter:image" content="<%= share_image %>">
<meta name="twitter:image:alt" content="<%= image_alt %>">
