<%
  if @page
    provide(:title, @page.og_title.presence || @page.title) unless content_for?(:title)
    provide(:description, @page.og_description) unless content_for?(:description)
    provide(:image, @page.og_image.url) if @page.cover? && !content_for?(:image)
    provide(:keywords, @page.keywords) unless content_for?(:keywords)
  end
%>
<title><%= full_title(yield(:title)) %></title>
<meta name="description" content="<%= meta_description(yield(:description)) %>">
<% if yield(:keywords).present? %><meta name="keywords" content="<%= yield(:keywords) %>"><% end %>
<link rel="canonical" href="<%= canonical %>">

<meta property="og:site_name" content="<%= site.name %>">
<meta property="og:locale" content="en">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= full_title(yield(:title)) %>">
<meta property="og:description" content="<%= meta_description(yield(:description)) %>">
<meta property="og:image" content="<%= meta_image(yield(:image)) %>">
<meta property="og:url" content="<%= canonical %>">

<meta name="twitter:card" content="summary_large_image">
