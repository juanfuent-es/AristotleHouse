<% provide(:theme, "day") %>
<article class="gutter pt-16 md:pt-24">
  <h1 class="headline"><%= @page&.title %></h1>
  <div class="mt-10"><% if @page && Content::Html.meaningful?(@page.content) %><%= rich_text(@page, preview: @preview) %><% else %><p>This text is being prepared.</p><% end %></div>
</article>
